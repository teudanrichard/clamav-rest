CLAMR_PROJECT_NAME=ClamAV HTTP Gateway
CLAMR_DEBUG=false
CLAMR_DOCS_ENABLED=true
# A Unix socket takes precedence when set (for a same-pod sidecar):
# CLAMR_BACKEND_SOCKET_PATH=/tmp/clamd.sock
CLAMR_BACKEND_HOST=127.0.0.1
CLAMR_BACKEND_PORT=3310
CLAMR_SOCKET_CONNECT_TIMEOUT=3
CLAMR_SOCKET_READ_TIMEOUT=30
CLAMR_SCAN_TIMEOUT=120
CLAMR_MAX_UPLOAD_SIZE=26214400
CLAMR_STREAM_CHUNK_SIZE=65536
CLAMR_MAX_CONCURRENT_SCANS=4
CLAMR_SCAN_QUEUE_TIMEOUT=10
# Comma-separated; leave empty to disable CORS:
CLAMR_CORS_ORIGINS=
CLAMR_LOG_LEVEL=INFO
CLAMR_METRICS_ENABLED=false
# Optional generic OIDC (Keycloak-compatible); issuer and audience are required when enabled.
CLAMR_OIDC_ENABLED=false
CLAMR_OIDC_ISSUER_URL=
CLAMR_OIDC_AUDIENCE=
CLAMR_OIDC_CLIENT_ID=
CLAMR_OIDC_ALLOWED_ALGORITHMS=RS256
CLAMR_OIDC_JWKS_CACHE_TTL=300
CLAMR_OIDC_JWKS_STALE_TTL=900
CLAMR_OIDC_CLOCK_SKEW=30
CLAMR_OIDC_HTTP_TIMEOUT=5
